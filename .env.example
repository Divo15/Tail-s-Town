DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
# Railway sets this automatically when a public domain is generated.
# If present, the app adds it to ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS.
RAILWAY_PUBLIC_DOMAIN=
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
# Enable HSTS only after HTTPS and the production domain are confirmed.
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False

POSTGRES_DB=petkit_db
POSTGRES_TEST_DB=test_petkit_db
POSTGRES_USER=replace-with-production-db-user
POSTGRES_PASSWORD=replace-with-production-db-password
POSTGRES_HOST=replace-with-production-db-host
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
# Optional alternative to the individual POSTGRES_* values above.
# Example: postgresql://user:password@host:5432/database
DATABASE_URL=

# Example SMTP mail settings for production.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-username
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=PETKIT <no-reply@your-domain.com>
